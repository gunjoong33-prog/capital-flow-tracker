// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 모든 원자료 지표의 시계열 저장소.
// 예: metric="WALCL", date=2026-07-23, value=6800000, source="fred"
// 콜드스타트 해소용 1년치 백필, 3/5/8단계의 "최근 1년 백분위" 계산의 기준 테이블.
model MetricValue {
  id        String   @id @default(cuid())
  metric    String // 예: WALCL, RRP, TGA, US10Y, JP10Y, KR10Y, CFTC_JPY_NET, NDX, RUT, DJI, SPX, BTC, ETH, GOLD, WTI, BRENT, USDKRW, USDJPY, VIX, SECTOR_XLK 등
  date      DateTime @db.Date
  value     Float
  source    String // fred | cftc | coingecko | eodhd | manual
  isManual  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([metric, date])
  @@index([metric, date])
}

// 매일 계산된 체크리스트 결과 스냅샷 (v2 프롬프트 1~8단계 + 최종 결론).
// 계산은 결정론적 코드로 하고, narrative만 LLM 1회 호출로 채운다.
model DailyReport {
  id                String   @id @default(cuid())
  date              DateTime @unique @db.Date
  step1             Json // 글로벌 환경: {newsCount, hasBigEvent, vetoTriggered}
  step2             Json // 유동성: {overseasScore, domesticAdjustment, finalScore, details}
  step3             Json // 캐리 트레이드: {spreadBp, zone, carryToVol, jpyVolSpike, cftcNetPosition, score}
  step4             Json // 환율금유가: {goldDir, realRateDir, dollarDir, quadrant, oilStatus}
  step5             Json // 자금도착: {ndxReturn20d, rutReturn20d, gap, btcReturn20d, ethReturn20d}
  step6             Json // 섹터: {sectors: [{name, return5d, volumeRatio, qualifies}]}
  step7             Json // 심리 필터: {vix, fearGreed, filterAction}
  step8             Json // 최종: {macroTrendScore, vetoApplied, finalDecision, positionSizePct}
  details           Json? // 단계별 판정 기준·실제값 표(UI 상세 테이블용) — {step1: [...], ..., step8: [...]}
  narrative         String? // LLM 생성 해설
  dataCompleteness  Json // 어떤 지표가 자동 확인/수동입력/확인못함인지
  createdAt         DateTime @default(now())
}

// 주/월/분기/년 리포트. 사이트 전용(노션 미게시).
model PeriodReport {
  id          String   @id @default(cuid())
  periodType  String // week | month | quarter | year
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  summary     Json // 기간 내 주요 지표 변화 요약
  narrative   String?
  createdAt   DateTime @default(now())

  @@unique([periodType, periodStart])
}

// 자동화 안 되는 지표(CNN F&G, 국내비중 설정)의 수동 입력 기록.
// MetricValue와 별개로 "언제 마지막으로 손으로 입력했는지" 추적용.
model ManualInputLog {
  id        String   @id @default(cuid())
  metric    String
  date      DateTime @db.Date
  value     Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([metric, date])
}

// 1단계 거부권 판정용 — 매일 파이프라인이 뉴스 헤드라인을 모아 Gemini로 "시장을 흔들 리스크인가" 판정,
// 리스크로 판단된 것만 저장한다(전부 저장하면 노이즈만 쌓임). 최근 7일 내 건수가 거부권 기준.
model NewsEvent {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  title     String
  url       String
  summary   String
  source    String // google-news | fed-press
  priority  Int      @default(2) // 0=백악관·연준 공식 발표, 1=권력 네트워크·엘리트 그룹 유출/폭로, 2=일반 지정학 뉴스
  severity  String   @default("normal") // "high"=단독으로도 즉시 거부권 발동, "normal"=누적 3건부터 발동(월가 GPR지수·BlackRock BGRI처럼 중요도 가중 반영)
  createdAt DateTime @default(now())

  @@unique([date, url])
  @@index([date])
}

// /news 페이지(주제별 뉴스) 표시용 — 매일 배치 때 딱 한 번만 계산해서 저장한다. 국내/해외 분류에
// Gemini 호출이 필요한데, 무료 티어 일일 할당량(20건)을 리포트 파이프라인의 judgeHeadlines()와
// 공유하기 때문에 방문할 때마다 실시간 분류하면 할당량을 순식간에 소진해 메인 리포트 생성까지
// 막을 위험이 있다 — 그래서 /news 페이지는 이 표를 읽기만 하고, 새로 고침은 하루 1회 배치가 담당.
model NewsPageHeadline {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  category    String // world-politics | world-economy | domestic-politics | domestic-economy | tech
  rank        Int // 표시 순서
  title       String
  url         String
  source      String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([date, category, url])
  @@index([date, category])
}

// FOMC·CPI·고용지표 등 예정된 발표일. 1단계 "14일 내 큰 이벤트" 판정 + 사이트 캘린더 표시용.
// FOMC는 연준이 공개하는 고정 일정이라 하드코딩 목록, CPI/고용지표는 FRED release/dates API로 매일 동기화.
model MajorEvent {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  name   String // "FOMC 회의 결과 발표", "미국 CPI 발표", "미국 고용지표 발표"
  source String // fed | fred

  @@unique([date, name])
  @@index([date])
}
