# Copy this file to .env / .env.local and fill in real values.
# Never commit the actual .env or .env.local files — they are gitignored.

# Database (Neon / Postgres via Vercel)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_PROJECT_ID=
PGDATABASE=
PGHOST=
PGHOST_UNPOOLED=
PGPASSWORD=
PGUSER=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=
VITE_NEON_AUTH_URL=

# Notion
NOTION_TOKEN=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Finnhub(애널리스트 등급분포, 무료 티어)
FINNHUB_API_KEY=

# GitHub Contents API(옵시디언 동기화) + repository_dispatch(자동수정 트리거) 겸용.
# repo 스코프의 PAT 필요 — 세분화된 토큰이면 Contents 쓰기 + Actions 트리거 권한 둘 다 확인.
GITHUB_EXPORT_TOKEN=

# 킬스위치 — 정확히 "true"로 명시적으로 설정해야만 자동수정이 활성화된다(fail-closed 기본값).
# 미설정·빈 값·"true" 아닌 값은 전부 비활성 취급되어 자가진단이 이상을 발견해도 알림만 보낸다.
AUTO_FIX_ENABLED=false

# Economic data providers
FRED_API_KEY=
ECOS_API_KEY=

# Korea Investment & Securities (KIS) API
KIS_APP_KEY=
KIS_APP_SECRET=

# Cron authentication
CRON_SECRET=

# 새 데일리 리포트 저장 시 알림을 보낼 Discord 채널의 Incoming Webhook URL.
DISCORD_WEBHOOK_URL=

# Vercel OIDC (auto-generated by Vercel, do not set manually in most cases)
VERCEL_OIDC_TOKEN=
