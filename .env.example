# Copy this file to .env / .env.local and fill in real values.
# Never commit the actual .env or .env.local files — they are gitignored.

# Database (Neon / Postgres via Vercel)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_PROJECT_ID=
PGDATABASE=
PGHOST=
PGHOST_UNPOOLED=
PGPASSWORD=
PGUSER=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=
VITE_NEON_AUTH_URL=

# Notion
NOTION_TOKEN=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Economic data providers
FRED_API_KEY=
ECOS_API_KEY=

# Korea Investment & Securities (KIS) API
KIS_APP_KEY=
KIS_APP_SECRET=

# Cron authentication
CRON_SECRET=

# 새 데일리 리포트 저장 시 알림을 보낼 Discord 채널의 Incoming Webhook URL.
DISCORD_WEBHOOK_URL=

# Vercel OIDC (auto-generated by Vercel, do not set manually in most cases)
VERCEL_OIDC_TOKEN=
